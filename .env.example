# Copy this file to .env and fill in every value below — ALL of them are
# required. This app has no local file storage: every branch/owner
# credential and every piece of business data (employees, drivers, tip
# entries, delivery entries) lives in a Google Sheet, so the server needs
# these to do anything at all, including a first-time login.
#
# ---- One-time setup in https://console.cloud.google.com/ ----
#   1. Create a project (or pick an existing one).
#   2. Enable the "Google Sheets API" (APIs & Services -> Library -> search
#      for it -> Enable).
#   3. "Configure consent screen" -> External -> fill the required fields
#      (app name, your email) -> Save. Testing mode is fine for personal use.
#   4. On the consent screen's "Data Access" page, add the sensitive scope
#      ".../auth/spreadsheets".
#   5. On the consent screen's "Audience" page, add your own Gmail address
#      under "Test users" — required for an unverified Testing-mode app to
#      be allowed to grant a sensitive scope to that account.
#   6. "Create Credentials" -> "OAuth client ID" -> Application type: Web
#      application. Under "Authorized redirect URIs", add exactly your
#      GOOGLE_REDIRECT_URI below (http://localhost:3000/auth/google/callback
#      for local dev; your production URL + /auth/google/callback for a
#      real deployment). Copy the generated Client ID and Client Secret.
#   7. Get a refresh token once: temporarily run the app locally with
#      GOOGLE_REFRESH_TOKEN left blank, sign in as Owner with the password,
#      go to Settings, and use "Sign in with Google" once — OR use Google's
#      OAuth Playground (https://developers.google.com/oauthplayground) with
#      your own Client ID/Secret and the scope
#      https://www.googleapis.com/auth/spreadsheets to mint one directly.
#      This is a one-time step: the refresh token below doesn't expire from
#      normal use, so you only need to do this once per deployment.
#   8. Create a blank Google Sheet (any name) in the account you want this
#      app's data to live in, and copy its ID from the URL:
#      https://docs.google.com/spreadsheets/d/THIS_PART_IS_THE_ID/edit
#      The app creates its own tabs and headers in it automatically on
#      first run — you don't need to set anything up inside the sheet.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=

# Required, and must be a FIXED value (not left blank) as soon as more than
# one server process might handle requests — e.g. on Vercel, where a login
# on one serverless instance must still be recognized by a different
# instance handling the next request. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
