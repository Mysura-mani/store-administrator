# Copy this file to .env and fill in the values to enable "Sign in with
# Google" (plus the Google Sheet data sync it unlocks) for the Owner account.
# Without these, the app works exactly as before (password-only owner login,
# local-file-only data storage) — all of this is entirely optional.
#
# Get these from https://console.cloud.google.com/apis/credentials
#   1. Create a project (or pick an existing one).
#   2. Enable the "Google Sheets API" (APIs & Services -> Library -> search
#      for it -> Enable).
#   3. "Configure consent screen" -> External -> fill the required fields
#      (app name, your email) -> Save. Testing mode is fine for personal use.
#   4. On the consent screen's "Data Access" page, add the sensitive scope
#      ".../auth/spreadsheets".
#   5. On the consent screen's "Audience" page, add your own Gmail address
#      under "Test users" — required for an unverified Testing-mode app to
#      be allowed to grant a sensitive scope to that account.
#   6. "Create Credentials" -> "OAuth client ID" -> Application type: Web
#      application.
#   7. Under "Authorized redirect URIs", add exactly:
#        http://localhost:3000/auth/google/callback
#      (or your GOOGLE_REDIRECT_URI below if different).
#   8. Copy the generated Client ID and Client Secret below.
#
# After setting these and restarting the server, log in as Owner with the
# password once, then set your Gmail address on the owner dashboard's
# Settings page to actually enable the "Sign in with Google" button. Signing
# in with it afterwards creates a Google Sheet under that account and starts
# syncing employees/drivers/entries into it automatically — see the README's
# "Owner sign-in with Google, and Google Sheet sync" section for details.

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Optional: a fixed session cookie secret. If omitted, a random one is
# generated each time the server starts (fine for local use, but it means
# everyone gets logged out whenever the server restarts).
SESSION_SECRET=
